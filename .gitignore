# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Kaggle / Secrets / Environment Variables
.env
.env.*
.kaggle/
kaggle.json
*.token

# Datasets & Raw Images (Do not push heavy data files or images to Git)
data/
dataset/
datasets/
downloads/
*.zip
*.tar.gz
*.tgz
*.rar

# Model weights & checkpoints (Prevent large binary files on Git)
models/*.pth
models/*.pt
models/*.bin
models/*.onnx
*.pth
*.pt
*.onnx

# Raw image file formats in root or data
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.webp

# Whitelist documentation & report assets
!reports/**/*.png
!reports/**/*.jpg
!reports/**/*.svg
!reports/**/*.md
!reports/**/*.csv

# IDEs & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
